# ────────────────────────────────────────────────────────────────
# 环境变量示例 —— 复制成 .env 放在项目根目录即可生效
#
#   cp .env.example .env
#
# 服务端启动时会自动读这个文件（见 app/server/src/config.ts）。
# Docker 部署时对应的位置是 docker-compose.yml 的 environment: 段。
# 全部变量都有默认值，**一个都不填也能跑起来**；下面标了「必须」的才需要关心。
# ────────────────────────────────────────────────────────────────

# ── 服务 ──────────────────────────────────────────────────────
PORT=9200
# 只绑回环 = 外部只能走反向代理进来（推荐，公网部署就这么用）
HOST=0.0.0.0

# ── 数据 ──────────────────────────────────────────────────────
# 数据库、上传的图、图标缓存都放这里
DATA_DIR=app/server/data
# 笔记目录。刻意独立于 DATA_DIR —— 想用网盘同步笔记就把它指到同步盘
# NOTES_DIR=/volume1/homes/me/notes

# ── 首次启动创建的管理员（之后改这里不再生效）────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ── 安全 ──────────────────────────────────────────────────────
# 允许未登录浏览首页内容（编辑仍然要登录）。私人导航页默认关着
PUBLIC_VIEW=false
# refresh Cookie 是否加 Secure —— 用 HTTPS 反代时打开
# COOKIE_SECURE=true
# 显式固定密钥：换机器部署、或想让旧登录态继续有效时给一个（留空则首次启动自动生成并存库）
# JWT_SECRET=
# 探针令牌：留空则首次启动自动生成，之后在设置页里看 / 重置
# AGENT_TOKEN=

# ── 其它 ──────────────────────────────────────────────────────
# 登录态（refresh token）有效期，天
REFRESH_DAYS=30
# Clash 订阅默认只拉取公网 HTTP(S) 地址。自建内网订阅源可显式允许：
SUBSCRIPTIONS_ALLOW_PRIVATE_NETWORK=false
# AI 路由助手默认只访问公网 HTTPS 接口；自建内网 OpenAI 兼容服务可显式允许：
AI_ALLOW_PRIVATE_NETWORK=false
# 单张上传图片的上限，MB
# MAX_UPLOAD_MB=25
# 单个动态壁纸视频的上限，MB；反向代理 client_max_body_size 建议设为 110m
# MAX_VIDEO_UPLOAD_MB=100
# 排障用：设成 1 会打印每条 SQL
# DEBUG_DB=0
