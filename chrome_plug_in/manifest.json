{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "0.8.0",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "__MSG_extensionName__"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "alarms", "idle", "clipboardWrite"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["*://*.bilibili.com/*"],
      "js": ["content/bilibili-theme-page.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["*://*.bilibili.com/*"],
      "js": ["content/bilibili-theme.js"],
      "css": ["content/bilibili-theme.css"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["*://taobao.com/*", "*://www.taobao.com/*", "*://s.taobao.com/*", "*://item.taobao.com/*", "*://detail.tmall.com/*", "*://i.taobao.com/*", "*://cart.taobao.com/*", "*://buyertrade.taobao.com/*", "*://item-paimai.taobao.com/*", "*://rate.taobao.com/*", "*://refund2.taobao.com/*", "*://rights.taobao.com/*", "*://jubao.taobao.com/*", "*://goofish.com/*", "*://www.goofish.com/*"],
      "js": ["content/shopping-theme.js", "content/shopping-account-theme.js"],
      "css": ["content/shopping-theme.css", "content/shopping-detail-theme.css", "content/shopping-account-theme.css", "content/shopping-account-adaptive.css"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/prompt.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
